BOT_TOKEN=123456:ABC-DEF
OWNER_USER_ID=123456789
GEMINI_KEYS_GENERATE=key-gen-1,key-gen-2
GEMINI_KEYS_EMBED=key-embed-1,key-gen-1
CHROMA_PATH=./data/chroma
DOWNLOADS_PATH=./downloads
RPM_LIMIT=15
RPD_LIMIT=1500
COOLDOWN_SEC=60
RAG_TOP_K=3
RAG_MAX_DISTANCE=1.2
GEMINI_GENERATE_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# NVIDIA Provider Configuration (Set AI_PROVIDER=nvidia to use ONLY NVIDIA NIM APIs for both generation and embeddings)
AI_PROVIDER=google
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_GENERATE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Embedded Web UI Configuration
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8000
